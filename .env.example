# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FLOW_PROXY_SERVER: optional. If your Google Flow account only accepts logins
# from a US IP, set this to your proxy so the dedicated Flow Chrome window
# (opened by /api/flow/login) routes ALL its traffic through it — login and
# every generation request. HTTP proxy example: "http://123.45.67.89:8080".
# Chrome does not take inline user:pass here — if the proxy needs auth,
# Chrome shows its own popup on first launch and you type it in by hand.
FLOW_PROXY_SERVER=""
